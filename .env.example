# Copy to .env and replace secrets for any non-demo deployment.
PORT=4000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
REFRESH_SECRET=replace-with-another-long-random-string

# SQLite file location (created and seeded automatically on first run)
DB_PATH=./data/deutsch-studio.db
DATA_DIR=./data

# Mock OTP shown in the UI in development. Never expose a fixed OTP in production.
DEV_OTP=123456

# Comma-separated allowed origins for cross-origin deployments. Leave empty for same-origin dev.
CORS_ORIGIN=

# Default password assigned by the admin console when creating users.
DEFAULT_NEW_USER_PASSWORD=Demo1234!

# Set to false to disable the no-login demo role switcher.
DEMO_AUTO_LOGIN=true

# ── Vercel / serverless (only when DB_DRIVER=postgres) ──────────────────────
# Local development stays on SQLite; Vercel needs a managed Postgres instance.
DB_DRIVER=sqlite
POSTGRES_URL=
# DATABASE_URL is accepted as an alias for POSTGRES_URL.
DATABASE_URL=
# Set to false for managed Postgres with TLS termination that does not need SSL.
PGSSL=true
# Private-ish blob store for uploads/audio. When set, files go to Vercel Blob
# instead of the ephemeral serverless filesystem; downloads stay authenticated.
BLOB_READ_WRITE_TOKEN=
# Set true for one deployment to seed demo data automatically, then turn off.
AUTO_SEED=false
