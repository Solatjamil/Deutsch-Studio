{
  "name": "deutsch-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Deutsch Studio - tutoring class management PWA",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @deutsch/api",
    "dev:web": "npm run dev -w @deutsch/web",
    "seed": "npm run seed -w @deutsch/api",
    "build": "npm run build -w @deutsch/web && npm run build -w @deutsch/api",
    "start": "npm run start -w @deutsch/api",
    "test": "node scripts/loop-test.mjs",
    "reset": "rm -f data/deutsch-studio.db && npm run seed",
    "test:ui": "node scripts/ui-loop.mjs",
    "test:all": "node scripts/loop-test.mjs && node scripts/ui-loop.mjs",
    "seed:postgres": "npm run seed:postgres -w @deutsch/api",
    "build:vercel": "node scripts/vercel-build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
